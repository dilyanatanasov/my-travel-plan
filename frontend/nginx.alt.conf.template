# Production nginx for Contrail (HTTPS, primary domain + alternate domain).
#
# Same as nginx.conf.template plus two server blocks that 301 the alternate
# domain (${ALT_DOMAIN}, e.g. mycontrail.app) to the canonical ${DOMAIN}.
# The alternate gets its own certificate: a redirect still needs valid TLS,
# and .app is HSTS-preloaded so the browser refuses plain HTTP outright.
#
# Selected by docker-entrypoint.d/10-select-nginx-template.sh only when
# certificates exist for BOTH domains; with only the primary cert present the
# single-domain template is used, so the alternate can be added later without
# touching the primary.

# Link-preview crawlers, for the UA-split on /s/ below. `map` must live at
# http level; this file is rendered into conf.d, which nginx.conf includes
# inside http{}, so top-of-file is that level. $http_user_agent and
# $is_crawler survive the envsubst step — NGINX_ENVSUBST_FILTER only
# substitutes DOMAIN-ish names.
map $http_user_agent $is_crawler {
    default 0;
    "~*(facebookexternalhit|twitterbot|whatsapp|telegrambot|linkedinbot|slackbot|discordbot|pinterest|skypeuripreview)" 1;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN} www.${DOMAIN};

    # Certbot's webroot challenge, must stay on plain HTTP
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# Alternate domain, plain HTTP: ACME challenge + redirect to canonical HTTPS.
# Only ever reached by non-HSTS clients (curl, old crawlers) — browsers jump
# straight to 443 because the .app TLD is HSTS-preloaded.
server {
    listen 80;
    listen [::]:80;
    server_name ${ALT_DOMAIN} www.${ALT_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# Alternate domain, HTTPS: valid cert, then redirect to canonical.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${ALT_DOMAIN} www.${ALT_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${ALT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ALT_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    return 301 https://${DOMAIN}$request_uri;
}

# www on HTTPS: 301 to the apex so there is exactly one canonical origin
# (matters for OG URLs, the PWA scope, and analytics not double-counting).
# The certificate already covers www — setup-ssl.sh issues for both names.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    return 301 https://${DOMAIN}$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    root /usr/share/nginx/html;
    index index.html;

    # Security headers. The app's own CSP is deliberately absent here: the map
    # pulls TopoJSON from a CDN, so a policy needs writing deliberately rather
    # than guessed at.
    include /etc/nginx/snippets/security-headers.conf;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 10m;
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # API. ^~ so the static-asset regex block below cannot intercept requests
    # that happen to end in .json or .png.
    location ^~ /api {
        # Resolve the upstream per request via Docker's embedded DNS rather
        # than once at startup. With a literal host, nginx refuses to boot if
        # the API container is not up yet, and keeps a stale IP after the API
        # is redeployed.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $backend_upstream http://backend:3000;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # The service worker must never be cached, or a stale one pins every
    # visitor to an old build until they clear site data.
    location = /sw.js {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Service-Worker-Allowed "/" always;
    }

    # Neither may the manifest or the entry document — they are how a client
    # discovers the current hashed bundles.
    location = /manifest.webmanifest {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        types { } default_type application/manifest+json;
    }

    # The version stamp behind the stale-tab reload prompt: always from the
    # server, or a cached copy would just report the cached build.
    location = /version.json {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    # Everything Vite fingerprints is safe to cache forever.
    location ~* \.(?:css|js|jpg|jpeg|gif|png|ico|svg|webp|woff|woff2|ttf|eot)$ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location /health {
        access_log off;
        return 200 "ok\n";
    }

    # Shared-map links: crawlers get server-rendered OG tags, humans get the
    # SPA exactly as before. rewrite…last re-enters location matching, so the
    # /api block above supplies the proxy plumbing (variable upstream +
    # resolver) — one upstream definition, not two. rewrite-last is one of
    # the forms that is safe inside `if`.
    location /s/ {
        if ($is_crawler) {
            rewrite ^/s/(.*)$ /api/share/unfurl/$1 last;
        }
        try_files $uri $uri/ /index.html;
    }

    # Duel links: crawlers get the scoreline ("31 – 24") as the preview; a
    # single-token challenge link unfurls as that person's map.
    location /duel/ {
        if ($is_crawler) {
            rewrite ^/duel/([^/]+)/([^/]+)$ /api/share/unfurl-duel/$1/$2 last;
        }
        if ($is_crawler) {
            rewrite ^/duel/([^/]+)$ /api/share/unfurl/$1 last;
        }
        try_files $uri $uri/ /index.html;
    }

    # Umami tracker ONLY — script + collect endpoint ride the main origin, so
    # there is no extra DNS/cert and no cross-site request for ad-blockers to
    # flag. The dashboard is deliberately not proxied: it binds to the
    # droplet's localhost and is reached over an SSH tunnel. Exact-match
    # locations, so the fingerprinted-asset regex can never capture script.js.
    location = /umami/script.js {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $umami_upstream http://umami:3000;
        rewrite ^ /script.js break;
        proxy_pass $umami_upstream;
        proxy_set_header Host $host;
    }
    location = /umami/api/send {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $umami_upstream http://umami:3000;
        rewrite ^ /api/send break;
        proxy_pass $umami_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Umami hashes the visitor from this — without it every visitor is
        # the nginx container.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA routes (/s/:token, /login, …) are resolved client-side.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
