# Absolute base URL for the Open Graph tags in index.html.
#
# Social scrapers do not resolve relative URLs — they have no page context —
# so og:url and og:image have to be absolute or the preview card silently
# fails. index.html references %VITE_PUBLIC_URL%, which Vite substitutes at
# build time from this file.
#
# It was referenced but never defined anywhere, so every production build
# shipped the literal string "%VITE_PUBLIC_URL%/" as its og:url.
#
# The .com is canonical: mycontrail.app serves the same app, but a single
# canonical origin is what keeps shares and previews consistent.
VITE_PUBLIC_URL=https://mycontrail.com
