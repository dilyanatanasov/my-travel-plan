# Production nginx for Contrail (HTTPS).
#
# Rendered from this template at container start by the official nginx image's
# envsubst step. NGINX_ENVSUBST_FILTER is set to DOMAIN so only ${DOMAIN} is
# substituted — nginx's own $uri, $host and friends must survive untouched.
#
# Selected by docker-entrypoint.d/10-select-nginx-template.sh only when a
# certificate for ${DOMAIN} actually exists; otherwise the HTTP-only template
# is used, so the container still boots before certbot has ever run.

# Link-preview crawlers, for the UA-split on /s/ below. `map` must live at
# http level; this file is rendered into conf.d, which nginx.conf includes
# inside http{}, so top-of-file is that level. $http_user_agent and
# $is_crawler survive the envsubst step — NGINX_ENVSUBST_FILTER only
# substitutes DOMAIN-ish names.
map $http_user_agent $is_crawler {
    default 0;
    "~*(facebookexternalhit|twitterbot|whatsapp|telegrambot|linkedinbot|slackbot|discordbot|pinterest|skypeuripreview)" 1;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN} www.${DOMAIN};

    # Certbot's webroot challenge, must stay on plain HTTP
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# www on HTTPS: 301 to the apex so there is exactly one canonical origin
# (matters for OG URLs, the PWA scope, and analytics not double-counting).
# The certificate already covers www — setup-ssl.sh issues for both names.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    return 301 https://${DOMAIN}$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    root /usr/share/nginx/html;
    index index.html;

    # Security headers. The app's own CSP is deliberately absent here: the map
    # pulls TopoJSON from a CDN, so a policy needs writing deliberately rather
    # than guessed at.
    include /etc/nginx/snippets/security-headers.conf;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 10m;
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # API. ^~ so the static-asset regex block below cannot intercept requests
    # that happen to end in .json or .png.
    location ^~ /api {
        # Resolve the upstream per request via Docker's embedded DNS rather
        # than once at startup. With a literal host, nginx refuses to boot if
        # the API container is not up yet, and keeps a stale IP after the API
        # is redeployed.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $backend_upstream http://backend:3000;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # The service worker must never be cached, or a stale one pins every
    # visitor to an old build until they clear site data.
    location = /sw.js {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Service-Worker-Allowed "/" always;
    }

    # Neither may the manifest or the entry document — they are how a client
    # discovers the current hashed bundles.
    location = /manifest.webmanifest {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        types { } default_type application/manifest+json;
    }

    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    # Everything Vite fingerprints is safe to cache forever.
    location ~* \.(?:css|js|jpg|jpeg|gif|png|ico|svg|webp|woff|woff2|ttf|eot)$ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location /health {
        access_log off;
        return 200 "ok\n";
    }

    # Shared-map links: crawlers get server-rendered OG tags, humans get the
    # SPA exactly as before. rewrite…last re-enters location matching, so the
    # /api block above supplies the proxy plumbing (variable upstream +
    # resolver) — one upstream definition, not two. rewrite-last is one of
    # the forms that is safe inside `if`.
    location /s/ {
        if ($is_crawler) {
            rewrite ^/s/(.*)$ /api/share/unfurl/$1 last;
        }
        try_files $uri $uri/ /index.html;
    }

    # SPA routes (/s/:token, /login, …) are resolved client-side.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
